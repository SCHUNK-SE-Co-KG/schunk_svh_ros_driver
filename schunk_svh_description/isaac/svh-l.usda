    {
        def Material "material_Kunststoff_Schwarz"
        {
            token outputs:mdl:displacement.connect = </svh/Looks/material_Kunststoff_Schwarz/Shader.outputs:out>
            token outputs:mdl:surface.connect = </svh/Looks/material_Kunststoff_Schwarz/Shader.outputs:out>
            token outputs:mdl:volume.connect = </svh/Looks/material_Kunststoff_Schwarz/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.07, 0.07, 0.07)
                color3f inputs:emissive_color = (0, 0, 0)
                token outputs:out
            }
